{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs"],
      "project": ["scripts/**/*.mjs"]
    },
    "packages/*": {
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "examples/*": {
      "entry": ["src/**/*.ts"],
      "project": ["src/**/*.ts"]
    }
  },
  "ignoreBinaries": ["yalc"]
}
