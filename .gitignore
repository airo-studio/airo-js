# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
build/
*.tsbuildinfo
# Source, not output: @airo-js/lynx's `./build` entry (the native build's
# rsbuild plugin) lives here, and `build/` above would silently drop it.
!packages/lynx/src/build/

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp
.cache/

# Env
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# yalc — local linking. The .yalc/ tree shouldn't appear in this repo
# (yalc add lives in the *consumer's* tree), but guard anyway in case
# someone runs it here by mistake.
.yalc/
yalc.lock

# Temporary
tmp/
.tmp/

.context/
.claude/
CLAUDE.md

# Playwright output (examples/full-site e2e)
test-results/
playwright-report/

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/
